# Clave de API de Anthropic. La lee SOLO el backend proxy (server/index.js).
# Nunca se expone al cliente. Copia este archivo a .env y pon tu clave real.
SICEP_TENDERPARSER=sk-ant-...

# (opcional) Puerto del backend proxy. Por defecto 3001.
PORT=3001

# (opcional) Modelo y limite de salida. Defaults razonables si se omiten.
SICEP_MODEL=claude-opus-4-20250514
SICEP_MAX_TOKENS=32000
