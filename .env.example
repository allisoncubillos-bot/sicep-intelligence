# === Google Calendar (OAuth2) ===
# Obtén CLIENT_ID y CLIENT_SECRET en Google Cloud Console (ver README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ejecuta `python setup_google_oauth.py` para obtener este valor una sola vez.
GOOGLE_REFRESH_TOKEN=
# ID del calendario donde se crearán los eventos. "primary" = calendario principal.
GOOGLE_CALENDAR_ID=primary

# === Slack (canal SEMANAL de audiencias: SICEP_DATES) ===
# Incoming Webhook URL (ver README).
SLACK_WEBHOOK_URL=
# Canal destino (opcional si el webhook ya apunta a un canal). Ej: #sicep-audiencias
SLACK_CHANNEL=#sicep-audiencias

# === Slack (canal DIARIO de pliegos definitivos) ===
SLACK_WEBHOOK_URL_PLIEGOS=
SLACK_CHANNEL_PLIEGOS=#daily_procesos_sicep_pliegosdef

# === Anthropic (Claude API, para resumir los pliegos) ===
# Tu API key de console.anthropic.com (empieza por sk-ant-...).
ANTHROPIC_API_KEY=

# === Local ===
# Carpeta donde se guardan los Excel de cantidades.
DOWNLOAD_FOLDER=./descargas_sicep
# Carpeta donde se guardan los pliegos definitivos (PDF).
PLIEGOS_FOLDER=./descargas_pliegos
# Archivo de estado: convocatorias ya procesadas en el canal diario.
STATE_FILE=./estado_pliegos.json
